# ==============================================================================
# ANURAG ENCLAVE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), add these keys to Project Settings > Environment Variables.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# 1. Master Administrative Passcode (Required - minimum 8 characters)
# Generate a strong, unique password:
ADMIN_PASSWORD=<SET_YOUR_STRONG_ADMIN_PASSWORD>

# 2. Cryptographic Session Secret (Required - minimum 32 characters)
# Generate using terminal command: openssl rand -hex 32
ADMIN_SECRET_KEY=<GENERATE_WITH_OPENSSL_RAND_HEX_32>

# 3. Supabase Cloud Database (Required in production to prevent lead loss)
# 1. Create a project at https://supabase.com
# 2. In Supabase Dashboard -> Project Settings -> API:
NEXT_PUBLIC_SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<YOUR_PUBLIC_ANON_KEY>
# Service-Role Key (Keep secret, server-only, never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=<YOUR_PRIVATE_SERVICE_ROLE_KEY>

# 4. Distributed Rate Limiting (Recommended for serverless / Vercel deployments)
# Create a free Redis database at https://upstash.com
UPSTASH_REDIS_REST_URL=https://<YOUR_UPSTASH_INSTANCE>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<YOUR_UPSTASH_REST_TOKEN>

# 5. Instant Lead Alerts (Optional - Telegram Bot or Webhook)
# Telegram: Create bot with @BotFather, get your chat ID with @userinfobot
TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<YOUR_TELEGRAM_CHAT_ID>
# Generic Webhook (Slack, Discord, or Zapier):
LEAD_ALERT_WEBHOOK_URL=https://<YOUR_WEBHOOK_URL>

# 6. Cloudflare Turnstile Bot Defense (Optional - free at https://dash.cloudflare.com)
TURNSTILE_SECRET_KEY=<YOUR_CLOUDFLARE_TURNSTILE_SECRET_KEY>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<YOUR_CLOUDFLARE_TURNSTILE_SITE_KEY>

# 7. Canonical Production Domain
NEXT_PUBLIC_SITE_URL=https://anuragenclave.com
